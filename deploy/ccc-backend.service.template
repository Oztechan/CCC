[Unit]
Description=CCC Backend (Ktor)
Documentation=https://github.com/Oztechan/CCC
After=network-online.target
Wants=network-online.target
# Never give up restarting, even after repeated rapid failures.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__GROUP__

# The SQLite file (application_database.sqlite.db) is created relative to the
# working directory, so this must stay pointed at the existing deploy dir.
WorkingDirectory=__APP_DIR__

Environment=IS_PRODUCTION=true

# JVM sizing for a small droplet. See deploy/README.md for the reasoning behind
# each flag; the short version is that heap and direct memory both default to a
# fraction of total RAM, so together they oversubscribe the box and the process
# grows until the kernel OOM killer takes it. Each needs an explicit ceiling.
#
# MaxRAMPercentage resolves against the MemoryMax cgroup limit below, not total
# RAM, because Java 21 is container-aware.
ExecStart=/usr/bin/java \
    -XX:MaxRAMPercentage=40 \
    -XX:MaxMetaspaceSize=128m \
    -XX:MaxDirectMemorySize=96m \
    -XX:+UseSerialGC \
    -XX:+ExitOnOutOfMemoryError \
    -Dkotlinx.coroutines.io.parallelism=8 \
    -Dfile.encoding=UTF-8 \
    -jar __APP_DIR__/__JAR_NAME__

# Safety net: if the process still creeps past its budget, the cgroup limit is
# hit and systemd restarts the service. Without this the kernel OOM killer picks
# a victim and nothing comes back up, which is the manual-restart chore this
# unit exists to remove.
#
# Deliberately no MemoryHigh. It throttles the cgroup and forces reclaim, but a
# JVM's footprint is almost entirely anonymous pages, which cannot be reclaimed
# on a droplet with no swap. The service would stall under sustained reclaim
# pressure instead of failing cleanly and restarting.
MemoryAccounting=yes
MemoryMax=__MEMORY_MAX__

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ccc-backend

# Hardening. The service only needs to read its jar and write its SQLite file.
# ProtectHome is resolved by setup-server.sh: it has to be off when the deploy
# directory itself lives under /home or /root, or the unit cannot see its jar.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=__PROTECT_HOME__
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=__APP_DIR__

[Install]
WantedBy=multi-user.target
